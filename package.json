{
  "name": "tabnews",
  "version": "1.0.0",
  "description": "Implementação do tabnews do curso.dev",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "services:up": "docker compose -f /infra/compose.yaml up -d",
    "services:down": "docker compose -f /infra/compose.yaml down",
    "services:start": "docker compose -f /infra/compose.yaml start",
    "services:stop": "docker compose -f /infra/compose.yaml stop",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "export": "next build && next export",
    "deploy": "next build && gh-pages -d out",
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watchAll"
  },
  "jest": {
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitorKogawa/tabnews.git"
  },
  "keywords": [
    "tabnews"
  ],
  "author": "vitorKogawa",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/vitorKogawa/tabnews/issues"
  },
  "homepage": "https://github.com/vitorKogawa/tabnews#readme",
  "dependencies": {
    "next": "^16.1.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "dotenv": "^17.2.3",
    "gh-pages": "^6.3.0",
    "jest": "^30.2.0",
    "pg": "^8.17.2",
    "prettier": "^3.8.0"
  }
}
